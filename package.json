{
  "name": "faultlane",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "faultlane": "tsx src/runner/cli.ts",
    "demo:click": "npm run faultlane -- run --config faultlane.click.config.ts",
    "demo:recovery": "npm run faultlane -- run --config faultlane.recovery.config.ts",
    "demo:broken-recovery": "npm run faultlane -- run --config faultlane.recovery-broken.config.ts",
    "fixture:start": "tsx examples/catalog/start.ts",
    "fixture:test": "npm run faultlane -- run --config faultlane.catalog.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:journeys": "playwright test tests/e2e/journey.spec.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run build && npm run build:cli && npm run test:package",
    "browsers:install": "playwright install chromium",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "npm run build:cli",
    "test:package": "tsx scripts/test-package.ts"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "esbuild": "^0.28.2",
    "vite": "^8.3.5"
  },
  "description": "Local-first browser API failure testing CLI",
  "bin": {
    "faultlane": "./dist/cli.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ]
}
